# ==============================================================================
# FRONTEND .gitignore - React 18 / Vite 5
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/

# Local Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Vite / Bundler Cache
.vite/
.eslintcache
