# Server Configuration
SERVER_PORT=8081
API_PREFIX=/api/v1.0

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dealership_db
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password

# JWT Security
# Generate a secure 256-bit or 512-bit Base64 secret key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Upload / Storage
STORAGE_UPLOAD_DIR=uploads/
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# Initial Admin Credentials (Provisioned on first startup if no admin exists)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminSecure@2026!
ADMIN_DEFAULT_EMAIL=admin@dealership.com
ADMIN_DEFAULT_FULLNAME=System Administrator

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
